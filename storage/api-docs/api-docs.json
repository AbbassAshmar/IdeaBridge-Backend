                "tags": [
                    "Ideas"
                ],
                "summary": "List ideas with optional filters",
                "operationId": "48ab92e08c6bfda7f356da68f0dbc791",
                "parameters": [
                    {
                        "name": "q",
                        "in": "query",
                        "description": "Search text in title or description",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "nullable": true,
                            "maxLength": 255
                        },
                        "example": "dark mode"
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "nullable": true,
                            "minimum": 1
                        },
                        "example": 1
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "Items per page",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "nullable": true,
                            "maximum": 100,
                            "minimum": 1
                        },
                        "example": 15
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Sort by creation date",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "nullable": true,
                            "enum": [
                                "asc",
                                "desc"
                            ]
